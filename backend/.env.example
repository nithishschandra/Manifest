# Copy to backend/.env for local development.
# Development defaults are fine on your own machine. Set real values before deploying.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://shoply:ShoplyDb2026LocalPassword@localhost:55432/shoply
# Production: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo accounts and products are created on startup. Set to false for a real store.
SEED_DEMO_DATA=true
