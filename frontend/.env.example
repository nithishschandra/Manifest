# Leave empty to use the built-in "/api" path (works with the Vite proxy and with the Docker/nginx setup).
# Only set this if the API lives on a different origin, e.g. https://api.example.com/api
VITE_API_URL=
# Show the demo login credentials on the sign-in page (always shown in `npm run dev`).
VITE_SHOW_DEMO=false
