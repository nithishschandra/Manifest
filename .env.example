# Copy this file to .env (same folder as docker-compose.yml) and replace every value.

# Password for the PostgreSQL database user "shoply".
# Database credentials may contain URL-special characters.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Signs login tokens. Must be random and at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-output-of-the-command-above

# "production" enforces the SECRET_KEY rules. Use "development" only on your own machine.
APP_ENV=production

# Public URL(s) the browser uses to open the store (comma-separated, no trailing slash).
FRONTEND_ORIGINS=http://localhost:8080

# Set to true only for local testing. Creates demo accounts with public passwords.
SEED_DEMO_DATA=false

# Host ports. Change them if these are already in use on your machine.
APP_PORT=8080
DB_PORT=55432

ACCESS_TOKEN_EXPIRE_MINUTES=1440
